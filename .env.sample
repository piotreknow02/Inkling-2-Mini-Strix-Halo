# Optional per-run overrides for start.sh.
#
# To use this file:  cp .env.sample .env   (the real .env is not tracked
# by git — this sample is what gets committed). Every variable below is
# optional; unset/removed values fall back to start.sh's own defaults.
#
# Precedence (highest first):
#   1. shell env vars already exported when you run ./start.sh
#   2. values in ./.env
#   3. start.sh inline defaults
#
# Values must not contain '=' — the parser splits each line on the first '='.

# Image tag and container name.
#IMAGE=inkling-mini-ciru-halo:latest
#CONTAINER_NAME=inkling-mini-ciru-halo

# Host publish port (container always listens on 18753 internally).
#PORT=8080

# Where the ~23 GB checkpoint lives / gets downloaded to.
#MODEL_DIR=./models

# Triton / ROCm / HF caches (persists the first kernel build across restarts).
#CACHE_DIR=./.cache

# HuggingFace model and revision.
#HF_MODEL=jcbtc/Inkling-2-Mini-CIRU-Halo-Agent-gfx1151
#HF_REVISION=                              # empty = latest; pin a commit for reproducibility

# Log file for the engine output stream.
#LOG_FILE=./.inkling.log

# Ready timeout (seconds). The first launch can take several minutes: the cold
# boot is ~65 s plus the first Triton kernel build.
#READY_TIMEOUT=3600

# ---- launch profile (forwarded to serve.sh via INKLING_* env) ---------------
# MODE=vision                       # vision|concurrent|single|long-context|sampling
# CONTEXT=1048576                   # max prompt+completion tokens (KV sized from it)
# SEQ_S=                            # empty = serve.sh derives (8 vision/concurrent, 1 else)
# KV_MIB=                           # empty = serve.sh sizes the BF16 KV pool; set e.g. 24576 on a tight box
# BATCH_TOKENS=4096                 # scheduler max_num_batched_tokens
# TOOLS=1                           # 1 = enable native Inkling tool calling; 0 = off
# EXTRA_ARGS=                       # extra serve.sh flags, space-separated (no '=' inside),
#                                   #   e.g. --no-graphs or --prefill-chunk-tokens 8192

# Optional: HuggingFace token for higher download rate limits.
# `hf` picks it up from env automatically; start.sh passes it through.
#HF_TOKEN=
